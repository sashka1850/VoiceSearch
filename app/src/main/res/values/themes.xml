<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose handles all theming at runtime via VoiceSearchTheme {}.
      This XML theme exists only so the OS has something to draw before
      the first Compose frame (system splash + status bar background).
    -->
    <style name="Theme.VoiceSearch.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
