<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths a FileProvider is willing to expose via content:// URIs.
  - exports: spreadsheets baked by ExportTableUseCase; recreated on every
    export so we never leak stale URIs.
  - crashes: local crash reports written by FileCrashReporter; user shares
    them from Settings to help debugging. Plain text, no personal data
    beyond the stack trace.
-->
<paths>
    <cache-path name="exports" path="exports/" />
    <files-path name="crashes" path="crashes/" />
</paths>
