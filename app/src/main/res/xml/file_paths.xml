<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths a FileProvider is willing to expose via content:// URIs.
  Only `cache-path` is enabled — exported spreadsheets live in
  context.cacheDir/exports/ and are recreated on every export so we never
  leak real user data through stale URIs.
-->
<paths>
    <cache-path name="exports" path="exports/" />
</paths>
