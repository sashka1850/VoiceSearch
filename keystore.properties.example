# Copy to keystore.properties (gitignored) and fill in real values
# before running `:app:assembleRelease` / `:app:bundleRelease`.
#
# Generate a keystore with:
#
#   keytool -genkeypair -v \
#     -keystore voicesearch-release.jks \
#     -alias voicesearch \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype JKS
#
# Store the .jks somewhere SAFE and OFF the repo (e.g. ~/.android/ or a
# password manager attachment). Losing the keystore means losing the
# ability to ship updates to existing installs — there's no reset.

# Path to the keystore file, relative to the project root.
RELEASE_STORE_FILE=voicesearch-release.jks

# Password set when creating the keystore (`-storepass`).
RELEASE_STORE_PASSWORD=changeme

# Alias passed to `keytool -alias`.
RELEASE_KEY_ALIAS=voicesearch

# Password for the alias (`-keypass`). For JKS keystores it's typically
# the same as the store password unless you explicitly set a different one.
RELEASE_KEY_PASSWORD=changeme
